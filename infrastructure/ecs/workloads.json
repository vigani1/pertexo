{
  "schemaVersion": 1,
  "platform": {
    "architecture": "X86_64",
    "cpu": "512",
    "memory": "1024",
    "networkMode": "awsvpc",
    "operatingSystem": "LINUX"
  },
  "workloads": {
    "api": {
      "kind": "service",
      "desiredCount": {
        "eu-central-1": 2
      },
      "command": ["node", "apps/api/dist/main.js"],
      "environment": {
        "AUTH_MAIL_MODE": "durable",
        "DATABASE_POOL_MAX": "5",
        "HOST": "0.0.0.0",
        "NODE_ENV": "production",
        "PORT": "3000",
        "SESSION_COOKIE_SECURE": "true"
      },
      "configuration": [
        "AUTH_MAIL_FROM",
        "ARTIFACT_STORE_BUCKET",
        "ARTIFACT_STORE_ENDPOINT",
        "ARTIFACT_STORE_FORCE_PATH_STYLE",
        "ARTIFACT_STORE_REGION",
        "CONNECTION_KMS_KEY_REFERENCE",
        "CONNECTION_KMS_REGION",
        "INVITATION_TOKEN_KEY_VERSION",
        "OIDC_AUTHORIZATION_ENDPOINT",
        "OIDC_CALLBACK_LANDING_PATH",
        "OIDC_CLIENT_ID",
        "OIDC_ISSUER",
        "OIDC_JWKS_URI",
        "OIDC_REDIRECT_URI",
        "OIDC_TOKEN_ENDPOINT",
        "OIDC_TRANSACTION_KEY_VERSION",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "PUBLIC_WEB_ORIGIN",
        "SERVICE_VERSION",
        "TRUST_PROXY_CIDRS"
      ],
      "secrets": [
        "ARTIFACT_STORE_ACCESS_KEY_ID",
        "ARTIFACT_STORE_SECRET_ACCESS_KEY",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "INVITATION_TOKEN_KEY",
        "REDIS_URL",
        "OIDC_CLIENT_SECRET",
        "OIDC_TRANSACTION_KEY"
      ],
      "sharedConfiguration": ["AUTH_MAIL_KEY_VERSION"],
      "sharedSecrets": ["AUTH_MAIL_KEY"],
      "port": 3000,
      "healthCheck": [
        "CMD-SHELL",
        "node -e \"fetch('http://127.0.0.1:3000/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
      ]
    },
    "worker": {
      "kind": "service",
      "desiredCount": {
        "eu-central-1": 2
      },
      "command": [
        "/bin/sh",
        "-c",
        "export WORKER_INSTANCE_ID=$HOSTNAME; exec node apps/worker/dist/main.js"
      ],
      "environment": {
        "AUTH_MAIL_DELIVERY_ENABLED": "true",
        "CONNECTION_RUN_HEALTH_MODE": "off",
        "DATABASE_DISPATCHER_POOL_MAX": "2",
        "DATABASE_MAINTENANCE_POOL_MAX": "2",
        "DATABASE_POOL_MAX": "5",
        "FAILURE_NOTIFICATION_RUN_TIMEOUT_CONTEXT_ENABLED": "false",
        "NODE_ENV": "production",
        "WORKER_MAX_EVENT_LOOP_DELAY_MILLIS": "200",
        "WORKER_MAX_RSS_BYTES": "805306368",
        "WORKER_RESOURCE_SAMPLE_MILLIS": "5000",
        "WORKER_RESOURCE_UNHEALTHY_SAMPLES": "3",
        "WORKFLOW_AUTO_PAUSE": "observe",
        "WORKSPACE_INBOX_PRODUCER": "true"
      },
      "configuration": [
        "ARTIFACT_STORE_BUCKET",
        "ARTIFACT_STORE_ENDPOINT",
        "ARTIFACT_STORE_FORCE_PATH_STYLE",
        "ARTIFACT_STORE_REGION",
        "CONNECTION_KMS_KEY_REFERENCE",
        "CONNECTION_KMS_REGION",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OUTBOX_DISPATCH_JOB_NAMES",
        "SERVICE_VERSION"
      ],
      "secrets": [
        "AUTH_MAIL_EMAIL_API_KEY",
        "DATABASE_URL",
        "DATABASE_MAINTENANCE_URL",
        "REDIS_URL",
        "ARTIFACT_STORE_ACCESS_KEY_ID",
        "ARTIFACT_STORE_SECRET_ACCESS_KEY"
      ],
      "sharedConfiguration": ["AUTH_MAIL_KEY_VERSION"],
      "sharedSecrets": ["AUTH_MAIL_KEY"],
      "healthCheck": [
        "CMD-SHELL",
        "test -f /tmp/pertexo-worker-ready && test ! -f /tmp/pertexo-worker-not-ready && kill -0 1"
      ]
    },
    "ops": {
      "kind": "job",
      "command": ["node", "apps/ops/dist/main.js"],
      "environment": {
        "NODE_ENV": "production"
      },
      "configuration": ["OTEL_EXPORTER_OTLP_ENDPOINT"],
      "secrets": ["DATABASE_MAINTENANCE_URL"]
    },
    "migration": {
      "kind": "release-job",
      "command": ["node", "packages/database/dist/migrate.js"],
      "environment": {
        "NODE_ENV": "production"
      },
      "configuration": [],
      "secrets": ["DATABASE_MIGRATION_URL"]
    }
  }
}
