{
  "schemaVersion": 1,
  "name": "webhook-burst-50-per-second",
  "scenario": "webhook-burst",
  "durationSeconds": 300,
  "requestsPerSecond": 50,
  "maxInFlight": 100,
  "method": "POST",
  "authentication": "webhook-hmac",
  "pathEnvironment": "PERTEXO_EXERCISE_WEBHOOK_PATH",
  "bodyFileEnvironment": "PERTEXO_EXERCISE_WEBHOOK_BODY_FILE",
  "headers": {
    "content-type": "application/json",
    "idempotency-key": "${requestId}"
  },
  "responsePolicy": {
    "expectedStatuses": [202],
    "expectedProblemCodes": []
  },
  "objectives": {
    "minimumAchievedRateRatio": 0.98,
    "maximumServerErrorRatio": 0.001,
    "maximumP95Milliseconds": 500
  }
}
