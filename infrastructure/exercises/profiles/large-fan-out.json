{
  "schemaVersion": 1,
  "name": "large-fan-out-starts",
  "scenario": "large-fan-out",
  "durationSeconds": 60,
  "requestsPerSecond": 10,
  "maxInFlight": 40,
  "method": "POST",
  "authentication": "session-cookie",
  "pathEnvironment": "PERTEXO_EXERCISE_FAN_OUT_PATH",
  "bodyFileEnvironment": "PERTEXO_EXERCISE_FAN_OUT_BODY_FILE",
  "headers": {
    "content-type": "application/json",
    "idempotency-key": "${requestId}"
  },
  "responsePolicy": {
    "expectedStatuses": [202],
    "expectedProblemCodes": []
  },
  "objectives": {
    "minimumAchievedRateRatio": 0.98,
    "maximumServerErrorRatio": 0.001,
    "maximumP95Milliseconds": 500
  }
}
