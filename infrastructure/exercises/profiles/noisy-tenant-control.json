{
  "schemaVersion": 1,
  "name": "noisy-tenant-control",
  "scenario": "noisy-tenant-control",
  "durationSeconds": 300,
  "requestsPerSecond": 10,
  "maxInFlight": 20,
  "method": "POST",
  "authentication": "session-cookie",
  "pathEnvironment": "PERTEXO_EXERCISE_CONTROL_TENANT_PATH",
  "bodyFileEnvironment": "PERTEXO_EXERCISE_CONTROL_TENANT_BODY_FILE",
  "headers": {
    "content-type": "application/json",
    "idempotency-key": "${requestId}"
  },
  "responsePolicy": {
    "expectedStatuses": [202],
    "expectedProblemCodes": []
  },
  "objectives": {
    "minimumAchievedRateRatio": 0.98,
    "maximumServerErrorRatio": 0.001,
    "maximumP95Milliseconds": 500
  }
}
