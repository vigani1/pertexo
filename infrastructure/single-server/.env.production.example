# Copy outside the checkout to /opt/pertexo/.env.production (mode 600).
# Append generate-secrets.mjs output once. Never rerun it over existing keys.
NODE_ENV=production
AUTH_MAIL_MODE=durable
SESSION_COOKIE_SECURE=true
PUBLIC_WEB_ORIGIN=
AUTH_MAIL_FROM=
# Default Resend delivery; use both API keys from the owner's provider account.
SYSTEM_MAIL_TRANSPORT=resend
AUTH_MAIL_EMAIL_API_KEY=
INVITATION_EMAIL_FROM=
INVITATION_EMAIL_API_KEY=
# Or choose smtp and omit both Resend API keys. These settings reach only worker.
# SYSTEM_MAIL_TRANSPORT=smtp
# SYSTEM_MAIL_SMTP_HOST=smtp.example.com
# SYSTEM_MAIL_SMTP_PORT=587
# SYSTEM_MAIL_SMTP_TLS=starttls
# SYSTEM_MAIL_SMTP_USER=
# SYSTEM_MAIL_SMTP_PASSWORD=
# For port 465 use implicit TLS. Plaintext is refused when deployed.
# Generated mode defaults to kms. Select self-managed with the generator option.
# For kms, supply these values (IAM roles can replace explicit AWS credentials):
# CONNECTION_KMS_KEY_REFERENCE=
# CONNECTION_KMS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Self-managed current key/version are generated; never use the development key.
# CONNECTION_SELF_MANAGED_PREVIOUS_KEYS=[{"version":"0","key":"<previous key>"}]
ARTIFACT_STORE_ENDPOINT=
ARTIFACT_STORE_REGION=us-east-1
ARTIFACT_STORE_BUCKET=pertexo-artifacts
ARTIFACT_STORE_FORCE_PATH_STYLE=true
TRUST_PROXY_CIDRS=172.30.42.0/24
# SERVICE_VERSION and host aliases are set by deploy.sh; do not set them here.
# Generated: BETTER_AUTH_SECRET, AUTH_MAIL_KEY, AUTH_MAIL_KEY_VERSION,
# INVITATION_TOKEN_KEY, INVITATION_TOKEN_KEY_VERSION, POSTGRES_SUPERUSER_PASSWORD,
# POSTGRES_MIGRATION_PASSWORD, POSTGRES_APP_PASSWORD, POSTGRES_MAINTENANCE_PASSWORD,
# DATABASE_MIGRATION_URL, DATABASE_URL, DATABASE_MAINTENANCE_URL, REDIS_PASSWORD,
# REDIS_URL, STORAGE_ADMIN_ACCESS_KEY_ID, STORAGE_ADMIN_SECRET_ACCESS_KEY,
# ARTIFACT_STORE_ACCESS_KEY_ID, ARTIFACT_STORE_SECRET_ACCESS_KEY.
# Optional social providers: AUTH_GOOGLE_CLIENT_ID / AUTH_GOOGLE_CLIENT_SECRET,
# AUTH_GITHUB_CLIENT_ID / AUTH_GITHUB_CLIENT_SECRET,
# AUTH_MICROSOFT_CLIENT_ID / AUTH_MICROSOFT_CLIENT_SECRET / AUTH_MICROSOFT_TENANT_ID,
# AUTH_APPLE_CLIENT_ID / AUTH_APPLE_CLIENT_SECRET.

# Nightly off-server backups. The owner creates a private Oracle Object Storage
# bucket and dedicated S3 credentials in slice 6. They are never sent to serving
# containers. Keep the originals with the environment for server recovery.
# BACKUP_STORE_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# BACKUP_STORE_REGION=
# BACKUP_STORE_BUCKET=
# BACKUP_STORE_ACCESS_KEY_ID=
# BACKUP_STORE_SECRET_ACCESS_KEY=
