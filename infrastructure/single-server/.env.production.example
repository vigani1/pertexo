# Copy outside the checkout to /opt/pertexo/.env.production (mode 600).
# Append generate-secrets.mjs output once. Never rerun it over existing keys.
NODE_ENV=production
AUTH_MAIL_MODE=durable
# Sign up first on a fresh install: the first verified account closes sign-up, and
# after that only an invited address can make one. Set to open only for a public service.
AUTH_SIGN_UP_MODE=invitation
# Enable after deploying the matching database/API readers.
AUTOMATION_TOKENS_ENABLED=true
SESSION_COOKIE_SECURE=true
PUBLIC_WEB_ORIGIN=
AUTH_MAIL_FROM=
# Default Resend delivery; use both API keys from the owner's provider account.
SYSTEM_MAIL_TRANSPORT=resend
AUTH_MAIL_EMAIL_API_KEY=
INVITATION_EMAIL_FROM=
INVITATION_EMAIL_API_KEY=
# Or choose smtp and omit both Resend API keys. These settings reach only worker.
# SYSTEM_MAIL_TRANSPORT=smtp
# SYSTEM_MAIL_SMTP_HOST=smtp.example.com
# SYSTEM_MAIL_SMTP_PORT=587
# SYSTEM_MAIL_SMTP_TLS=starttls
# SYSTEM_MAIL_SMTP_USER=
# SYSTEM_MAIL_SMTP_PASSWORD=
# For port 465 use implicit TLS. Plaintext is refused when deployed.
# The generator makes self-managed keys unless given --encryption=kms.
# For kms, supply these values (IAM roles can replace explicit AWS credentials):
# CONNECTION_KMS_KEY_REFERENCE=
# CONNECTION_KMS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Self-managed current key/version are generated; never use the development key.
# CONNECTION_SELF_MANAGED_PREVIOUS_KEYS=[{"version":"0","key":"<previous key>"}]
ARTIFACT_STORE_ENDPOINT=
ARTIFACT_STORE_REGION=us-east-1
ARTIFACT_STORE_BUCKET=pertexo-artifacts
ARTIFACT_STORE_FORCE_PATH_STYLE=true
# Dedicated per-worker disk volume; keep this path aligned with Compose.
ARTIFACT_SCRATCH_DIRECTORY=/var/lib/pertexo/artifact-scratch
TRUST_PROXY_CIDRS=172.30.42.0/24
# SERVICE_VERSION and host aliases are set by deploy.sh; do not set them here.
# Sign-up closes once the first account is verified; after that people need an
# invitation. "open" lets anyone who can reach this server create an account.
# AUTH_SIGN_UP_MODE=invitation
# Generated: BETTER_AUTH_SECRET, AUTH_MAIL_KEY, AUTH_MAIL_KEY_VERSION,
# INVITATION_TOKEN_KEY, INVITATION_TOKEN_KEY_VERSION, CALLBACK_TOKEN_KEY,
# CALLBACK_TOKEN_KEY_VERSION, POSTGRES_SUPERUSER_PASSWORD,
# POSTGRES_MIGRATION_PASSWORD, POSTGRES_APP_PASSWORD, POSTGRES_MAINTENANCE_PASSWORD,
# DATABASE_MIGRATION_URL, DATABASE_URL, DATABASE_MAINTENANCE_URL, REDIS_PASSWORD,
# REDIS_URL, STORAGE_ADMIN_ACCESS_KEY_ID, STORAGE_ADMIN_SECRET_ACCESS_KEY,
# ARTIFACT_STORE_ACCESS_KEY_ID, ARTIFACT_STORE_SECRET_ACCESS_KEY.
# Optional social providers: AUTH_GOOGLE_CLIENT_ID / AUTH_GOOGLE_CLIENT_SECRET,
# AUTH_GITHUB_CLIENT_ID / AUTH_GITHUB_CLIENT_SECRET,
# AUTH_MICROSOFT_CLIENT_ID / AUTH_MICROSOFT_CLIENT_SECRET / AUTH_MICROSOFT_TENANT_ID,
# AUTH_APPLE_CLIENT_ID / AUTH_APPLE_CLIENT_SECRET.

# Nightly off-server backups: a private bucket on any S3-compatible store, with
# dedicated credentials. They are never sent to serving containers. Keep the
# originals with this file for server recovery.
# BACKUP_STORE_ENDPOINT=https://s3.example.net
# BACKUP_STORE_REGION=
# BACKUP_STORE_BUCKET=
# BACKUP_STORE_ACCESS_KEY_ID=
# BACKUP_STORE_SECRET_ACCESS_KEY=
# A dead-man switch address: requested after each backup, with /fail if it failed.
# BACKUP_HEARTBEAT_URL=

# check.sh alerts this webhook about disk, backups, stopped services, readiness,
# the proxy path and stuck runs. The thresholds below are the defaults.
# ALERT_WEBHOOK_URL=
# ALERT_DISK_PERCENT=90
# ALERT_BACKUP_MAX_AGE_HOURS=30
# ALERT_STUCK_MINUTES=30

# Code steps run in the dedicated runner. The memory setting caps its V8 heap;
# deployment preparation derives additional native-process/container headroom.
CODE_STEPS_ENABLED=true
CODE_RUNNER_MEMORY_MB=128
CODE_RUNNER_MAX_SECONDS=30
CODE_RUNNER_CONCURRENCY=2
CODE_RUNNER_PACKAGES=[]
CODE_RUNNER_PYTHON_PACKAGES=[]

# HTTP Request steps reach only public addresses. To let them call services on
# your own network, list those networks as CIDRs, for example
# 10.0.0.0/8,192.168.1.20/32. Plain http is allowed only inside them; cloud
# metadata addresses stay blocked. A malformed entry stops the worker.
# HTTP_ALLOWED_PRIVATE_NETWORKS=

# Optional organization SSO. Fresh-install generate-secrets.mjs includes this key.
# Keep it and every previous version in your password manager, outside backups.
# AUTH_FEDERATION_KEY=<generated-base64-32-byte-key>
# AUTH_FEDERATION_KEY_VERSION=1
# AUTH_FEDERATION_PREVIOUS_KEYS=[]

# Retain original callback versions until their run details expire. Supply from
# your password manager separately from a backup; never rerun the fresh-install generator.
# CALLBACK_TOKEN_PREVIOUS_KEYS=[{"version":"1","key":"original-base64-key"}]
