[Unit]
Description=Capture a matched Pertexo beta recovery point
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pertexo
UMask=0077
TimeoutStartSec=infinity
Environment=PERTEXO_BETA_ROOT=/opt/pertexo
ExecStart=/opt/pertexo/repository/infrastructure/single-server/backup.sh
