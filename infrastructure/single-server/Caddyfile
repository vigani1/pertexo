{
	admin off
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri replace REDACTED
				request>headers delete
				resp_headers>Location delete
			}
		}
	}
}

# Browsers keep to HTTPS for a year after their first visit.
(https_only) {
	header Strict-Transport-Security "max-age=31536000"
}

{$APP_HOST} {
	import https_only
	# Capability paths must bypass nginx request/error logs.
	handle /v1/auth/* {
		reverse_proxy api:3000
	}
	handle /hooks/* {
		reverse_proxy api:3000
	}
	handle /v1/notifications/unsubscribe/one-click {
		reverse_proxy api:3000
	}
	# Its query holds an OAuth2 code and state.
	handle /v1/connections/oauth2/callback {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:8080 {
			flush_interval -1
		}
	}
}

{$FILES_HOST} {
	import https_only
	@administration path /rustfs/admin /rustfs/admin/* /minio/admin /minio/admin/*
	respond @administration 404
	reverse_proxy storage:9000
}
