{
  "openapi": "3.1.0",
  "info": {
    "title": "Pertexo Catalog API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/node-definitions": {
      "get": {
        "operationId": "listNodeDefinitions",
        "security": [
          {
            "cookieSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Available node definitions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDefinitionListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      }
    },
    "/v1/integrations": {
      "get": {
        "operationId": "listIntegrations",
        "security": [
          {
            "cookieSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Available integrations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogQuery": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "ApiProblem": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "readOnly": true,
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "code": {
            "type": "string",
            "enum": [
              "auth.unauthenticated",
              "auth.forbidden",
              "resource.not_found",
              "request.invalid",
              "request.precondition_required",
              "request.idempotency_conflict",
              "request.rate_limited",
              "request.rate_limit_unavailable",
              "workspace.quota_exceeded",
              "artifact.conflict",
              "artifact.unavailable",
              "workspace.conflict",
              "workflow.revision_conflict",
              "workflow.lifecycle_conflict",
              "workflow.invalid",
              "workflow.not_published",
              "workflow.activation_failed",
              "run.not_cancelable",
              "run.outcome_unknown",
              "connection.conflict",
              "connection.reauthorization_required",
              "connection.revoked",
              "provider.rate_limited",
              "provider.unavailable",
              "platform.write_paused",
              "webhook.authentication_failed",
              "webhook.payload_too_large",
              "webhook.unsupported_media_type",
              "webhook.invalid_json",
              "webhook.idempotency_conflict",
              "webhook.rate_limited",
              "webhook.unavailable",
              "internal.unexpected"
            ]
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "errors": {
            "readOnly": true,
            "maxItems": 100,
            "type": "array",
            "items": {
              "readOnly": true,
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 1024
                },
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "path",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "additionalProperties": false
      },
      "NodeDefinitionListResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "readOnly": true,
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "release": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "epoch": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^node-compat:v1:sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "epoch",
              "fingerprint"
            ],
            "additionalProperties": false
          },
          "items": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "readOnly": true,
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": 2
                    }
                  ]
                },
                "definition": {
                  "readOnly": true,
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)*$"
                    },
                    "version": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "key",
                    "version"
                  ],
                  "additionalProperties": false
                },
                "family": {
                  "type": "string",
                  "enum": [
                    "trigger",
                    "action",
                    "logic",
                    "transform",
                    "output"
                  ]
                },
                "configVersion": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "configSchema": {
                  "readOnly": true,
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "additionalProperties": {
                    "$ref": "#/components/schemas/NodeDefinitionListResponse/$defs/__schema0"
                  }
                },
                "inputSchema": {
                  "readOnly": true,
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "additionalProperties": {
                    "$ref": "#/components/schemas/NodeDefinitionListResponse/$defs/__schema0"
                  }
                },
                "outputSchema": {
                  "readOnly": true,
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "additionalProperties": {
                    "$ref": "#/components/schemas/NodeDefinitionListResponse/$defs/__schema0"
                  }
                },
                "ports": {
                  "readOnly": true,
                  "type": "object",
                  "properties": {
                    "inputs": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "outputs": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    }
                  },
                  "required": [
                    "inputs",
                    "outputs"
                  ],
                  "additionalProperties": false
                },
                "credentialRequirements": {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "connectionRequirements": {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "integration": {
                  "readOnly": true,
                  "type": "object",
                  "properties": {
                    "providerKey": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)*$"
                    },
                    "operationKey": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)*$"
                    }
                  },
                  "required": [
                    "providerKey",
                    "operationKey"
                  ],
                  "additionalProperties": false
                },
                "retryClass": {
                  "type": "string",
                  "enum": [
                    "safe",
                    "idempotent-with-key",
                    "unsafe"
                  ]
                },
                "resourceClass": {
                  "type": "string",
                  "enum": [
                    "io",
                    "cpu"
                  ]
                },
                "capabilities": {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "lifecycle": {
                  "type": "string",
                  "enum": [
                    "active",
                    "deprecated",
                    "migration_required",
                    "retired"
                  ]
                },
                "available": {
                  "type": "boolean",
                  "description": "Definition is available for new workflow placement."
                },
                "publishable": {
                  "type": "boolean",
                  "description": "Definition may be selected for publication after full workflow validation."
                }
              },
              "required": [
                "schemaVersion",
                "definition",
                "family",
                "configVersion",
                "configSchema",
                "inputSchema",
                "outputSchema",
                "ports",
                "credentialRequirements",
                "connectionRequirements",
                "retryClass",
                "resourceClass",
                "capabilities",
                "lifecycle",
                "available",
                "publishable"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schemaVersion",
          "release",
          "items"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NodeDefinitionListResponse/$defs/__schema0"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/components/schemas/NodeDefinitionListResponse/$defs/__schema0"
                }
              }
            ]
          }
        }
      },
      "IntegrationListResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "readOnly": true,
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "release": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "epoch": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^node-compat:v1:sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "epoch",
              "fingerprint"
            ],
            "additionalProperties": false
          },
          "items": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "readOnly": true,
              "type": "object",
              "properties": {
                "providerKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)*$"
                },
                "operationKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)*$"
                },
                "nodeDefinitions": {
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "readOnly": true,
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)*$"
                      },
                      "version": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "key",
                      "version"
                    ],
                    "additionalProperties": false
                  }
                },
                "available": {
                  "type": "boolean",
                  "description": "At least one operation definition is available for placement."
                },
                "publishable": {
                  "type": "boolean",
                  "description": "At least one operation definition may be published after full validation."
                }
              },
              "required": [
                "providerKey",
                "operationKey",
                "nodeDefinitions",
                "available",
                "publishable"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schemaVersion",
          "release",
          "items"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid discovery query",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "Authentication required",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limited",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            }
          }
        }
      },
      "Unexpected": {
        "description": "Unexpected server error",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "cookieSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "pertexo_session"
      }
    }
  }
}
