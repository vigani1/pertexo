              },
              "healthStatus": {
                "type": "string",
                "enum": [
                  "healthy",
                  "degraded",
                  "unhealthy",
                  "disabled"
                ]
              },
              "lastErrorCode": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 128
                  },
                  {
                    "type": "null"
