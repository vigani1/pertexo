                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recurrence": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "cron"
                      },
                      "expression": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "timezone": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "kind",
                      "expression",
                      "timezone"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "interval"
                      },
                      "intervalMinutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 43200
                      }
                    },
                    "required": [
                      "kind",
                      "intervalMinutes"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "misfirePolicy": {
                "type": "string",
                "enum": [
                  "catch_up_once",
                  "skip"
                ]
              },
              "nextFireAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "lastFireAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "workflowId",
              "workflowVersionId",
              "nodeId",
              "kind",
              "status",
              "healthStatus",
              "lastErrorCode",
              "reconciledAt",
              "recurrence",
              "misfirePolicy",
              "nextFireAt",
              "lastFireAt"
            ],
            "additionalProperties": false
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "trigger",
          "replayed"
        ],
        "additionalProperties": false
      },
