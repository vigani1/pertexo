{
  "schemas": {
    "ApiProblem": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "readOnly": true,
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "code": {
          "type": "string",
          "enum": [
            "callback.already_received",
            "callback.expired",
            "callback.unavailable",
            "api_token.unavailable",
            "api_token.limit",
            "auth.unauthenticated",
            "auth.forbidden",
            "auth.email_not_verified",
            "auth.sso_required",
            "auth.two_factor_locked",
            "auth.method_limit",
            "auth.recovery_required",
            "auth.organization_email_managed",
            "auth.alternative_required",
            "auth.reset_link_invalid",
            "auth.conflict",
            "auth.session_not_fresh",
            "resource.not_found",
            "request.invalid",
            "request.precondition_required",
            "request.idempotency_conflict",
            "request.rate_limited",
            "request.rate_limit_unavailable",
            "workspace.quota_exceeded",
            "artifact.too_large",
            "artifact.conflict",
            "artifact.unavailable",
            "workspace.conflict",
            "workspace.revision_conflict",
            "workspace.member_role_revision_conflict",
            "workspace.member_role_transition_conflict",
            "workspace.member_removal_conflict",
            "workspace.member_directory_managed",
            "workspace.member_status_conflict",
            "workspace.invitation_conflict",
            "workspace.invitation_proof_expired",
            "workspace.invitation_revision_conflict",
            "workspace.invitation_recipient_mismatch",
            "workspace.invitation_unavailable",
            "workspace.invitation_delivery_unavailable",
            "workspace.invitation_not_configured",
            "user.profile_revision_conflict",
            "workflow.revision_conflict",
            "workflow.lifecycle_conflict",
            "workflow.name_conflict",
            "workflow.pause_conflict",
            "workflow.auto_pause_settings_conflict",
            "workflow.already_running",
            "workflow.concurrency_revision_conflict",
            "workflow.concurrency_limit_exceeded",
            "workflow.concurrency_limit_unavailable",
            "workflow.publish_approval_required",
            "workflow.publication_review_conflict",
            "workflow.promotion_conflict",
            "workflow.promotion_unavailable",
            "workflow.collaboration_conflict",
            "workflow.error_policy_conflict",
            "workflow.error_target_unavailable",
            "pending_task.already_resolved",
            "pending_task.expired",
            "pending_task.run_closed",
            "pending_task.self_decision",
            "pending_task.not_eligible",
            "notifications.changed",
            "notifications.unavailable",
            "notifications.unsubscribe_unavailable",
            "variables.changed",
            "variables.usage_changed",
            "workflow.variable_snapshot_unavailable",
            "trigger.coordination_unavailable",
            "form.unavailable",
            "form.changed",
            "form.access_conflict",
            "form.invalid",
            "form.file_type_not_allowed",
            "form.file_too_large",
            "form.upload_limit",
            "form.required",
            "workflow.sample_conflict",
            "workflow.sample_invalid",
            "workflow.sample_limit",
            "workflow.input_case_revision_conflict",
            "workflow.input_case_limit_exceeded",
            "workflow.tag_key_conflict",
            "workflow.tag_limit_exceeded",
            "workflow.tag_revision_conflict",
            "workflow.tag_delete_overflow",
            "workflow.organization_revision_conflict",
            "workflow.folder_name_conflict",
            "workflow.folder_limit_exceeded",
            "workflow.folder_revision_conflict",
            "workflow.folder_hierarchy_conflict",
            "workflow.folder_not_empty",
            "workflow.folder_not_visible",
            "workflow.folder_audience_review_required",
            "workspace.auto_pause_settings_conflict",
            "workflow.invalid",
            "workflow.portability_unavailable",
            "workflow.portability_compatibility_conflict",
            "workflow.portability_review_conflict",
            "workflow.portability_invalid",
            "workflow.template_origin_unavailable",
            "workflow.validation_unavailable",
            "workflow.published_version_conflict",
            "workflow.not_published",
            "workflow.activation_failed",
            "run.not_cancelable",
            "run.outcome_unknown",
            "run.recovery_unavailable",
            "connection.not_configured",
            "webhook.not_configured",
            "connection.conflict",
            "connection.revoked",
            "provider.unavailable",
            "webhook.authentication_failed",
            "webhook.payload_too_large",
            "webhook.unsupported_media_type",
            "webhook.invalid_json",
            "webhook.method_not_allowed",
            "webhook.idempotency_conflict",
            "webhook.rate_limited",
            "webhook.workflow_paused",
            "webhook.unavailable",
            "request.aborted",
            "internal.unexpected"
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "errors": {
          "readOnly": true,
          "maxItems": 100,
          "type": "array",
          "items": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 1024
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "path",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "requestId"
      ],
      "additionalProperties": false
    },
    "ArtifactUploadRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5368709120
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[^\\s/;]+\\/[^\\r\\n]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "byteLength",
        "mediaType",
        "sha256"
      ],
      "additionalProperties": false
    },
    "ArtifactFinalizeRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ArtifactMetadataResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5368709120
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[^\\s/;]+\\/[^\\r\\n]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "available"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "workspaceId",
        "byteLength",
        "mediaType",
        "sha256",
        "status",
        "createdAt",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "ArtifactUploadResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "workspaceId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5368709120
            },
            "mediaType": {
              "type": "string",
              "minLength": 3,
              "maxLength": 255,
              "pattern": "^[^\\s/;]+\\/[^\\r\\n]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "status": {
              "type": "string",
              "const": "pending"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "id",
            "workspaceId",
            "byteLength",
            "mediaType",
            "sha256",
            "status",
            "createdAt",
            "expiresAt"
          ],
          "additionalProperties": false
        },
        "upload": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "PUT"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "headers": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "expiresInSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 900
            }
          },
          "required": [
            "method",
            "url",
            "headers",
            "expiresAt",
            "expiresInSeconds"
          ],
          "additionalProperties": false
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "artifact",
        "upload",
        "replayed"
      ],
      "additionalProperties": false
    },
    "ArtifactDownloadResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "GET"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "expiresInSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 900
        }
      },
      "required": [
        "method",
        "url",
        "expiresAt",
        "expiresInSeconds"
      ],
      "additionalProperties": false
    }
  }
}
