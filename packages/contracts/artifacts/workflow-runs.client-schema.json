        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "code": {
          "type": "string",
          "enum": [
            "auth.unauthenticated",
            "auth.forbidden",
            "resource.not_found",
            "request.invalid",
            "request.precondition_required",
            "request.idempotency_conflict",
            "request.rate_limited",
            "request.rate_limit_unavailable",
            "workspace.quota_exceeded",
            "workspace.conflict",
            "workflow.revision_conflict",
            "workflow.invalid",
            "workflow.not_published",
            "workflow.activation_failed",
            "run.not_cancelable",
            "run.outcome_unknown",
            "connection.conflict",
            "connection.reauthorization_required",
            "connection.revoked",
            "provider.rate_limited",
            "provider.unavailable",
            "platform.write_paused",
            "webhook.authentication_failed",
            "webhook.payload_too_large",
            "webhook.unsupported_media_type",
            "webhook.invalid_json",
            "webhook.idempotency_conflict",
            "webhook.rate_limited",
            "webhook.unavailable",
            "internal.unexpected"
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "errors": {
          "readOnly": true,
          "maxItems": 100,
          "type": "array",
          "items": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 1024
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "path",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "requestId"
      ],
      "additionalProperties": false
    },
