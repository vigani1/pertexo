{
  "schemaVersion": "1.0.0",
  "schemas": {
    "ApiProblem": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "readOnly": true,
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "code": {
          "type": "string",
          "enum": [
            "auth.unauthenticated",
            "auth.forbidden",
            "resource.not_found",
            "request.invalid",
            "request.precondition_required",
            "request.idempotency_conflict",
            "workspace.quota_exceeded",
            "workspace.conflict",
            "workflow.revision_conflict",
            "workflow.invalid",
            "workflow.not_published",
            "workflow.activation_failed",
            "run.not_cancelable",
            "run.outcome_unknown",
            "connection.conflict",
            "connection.reauthorization_required",
            "connection.revoked",
            "provider.rate_limited",
            "provider.unavailable",
            "internal.unexpected"
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "errors": {
          "readOnly": true,
          "maxItems": 100,
          "type": "array",
          "items": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 1024
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "path",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "requestId"
      ],
      "additionalProperties": false
    },
    "ConnectionCreateRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "providerKey": {
              "type": "string",
              "const": "http"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "credential": {
              "readOnly": true,
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "type": {
                  "type": "string",
                  "const": "http_headers"
                },
                "headers": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                }
              },
              "required": [
                "schemaVersion",
                "type",
                "headers"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "providerKey",
            "name",
            "credential"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "providerKey": {
              "type": "string",
              "const": "email"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "credential": {
              "readOnly": true,
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "type": {
                  "type": "string",
                  "const": "resend_api_key"
                },
                "apiKey": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 512,
                  "pattern": "^re_[A-Za-z0-9_-]+$"
                },
                "fromEmail": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 254
                }
              },
              "required": [
                "schemaVersion",
                "type",
                "apiKey",
                "fromEmail"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "providerKey",
            "name",
            "credential"
          ],
          "additionalProperties": false
        },
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "providerKey": {
              "type": "string",
              "const": "slack"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "credential": {
              "readOnly": true,
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "type": {
                  "type": "string",
                  "const": "slack_bot_token"
                },
                "botToken": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 512,
                  "pattern": "^xoxb-[A-Za-z0-9-]+$"
                }
              },
              "required": [
                "schemaVersion",
                "type",
                "botToken"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "providerKey",
            "name",
            "credential"
          ],
          "additionalProperties": false
        }
      ]
    },
