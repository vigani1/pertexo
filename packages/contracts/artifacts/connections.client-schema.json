{
  "schemaVersion": "1.0.0",
  "schemas": {
    "ApiProblem": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "readOnly": true,
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "code": {
          "type": "string",
          "enum": [
            "auth.unauthenticated",
            "auth.forbidden",
            "resource.not_found",
            "request.invalid",
            "request.precondition_required",
            "request.idempotency_conflict",
            "workspace.quota_exceeded",
            "workspace.conflict",
            "workflow.revision_conflict",
            "workflow.invalid",
            "workflow.not_published",
            "workflow.activation_failed",
            "run.not_cancelable",
            "run.outcome_unknown",
            "connection.conflict",
            "connection.reauthorization_required",
            "connection.revoked",
            "provider.rate_limited",
            "provider.unavailable",
            "internal.unexpected"
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "errors": {
          "readOnly": true,
          "maxItems": 100,
          "type": "array",
          "items": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 1024
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "path",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "requestId"
      ],
      "additionalProperties": false
    },
    "ConnectionCreateRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "readOnly": true,
      "type": "object",
      "properties": {
        "providerKey": {
          "type": "string",
          "const": "http"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "credential": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "http_headers"
            },
            "headers": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            }
          },
          "required": [
            "schemaVersion",
            "type",
            "headers"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "providerKey",
        "name",
        "credential"
      ],
      "additionalProperties": false
    },
    "ConnectionResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "readOnly": true,
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "providerKey": {
          "type": "string",
          "const": "http"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authType": {
          "type": "string",
          "const": "http_headers"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "reauthorization_required",
            "revoked"
          ]
        },
        "secretVersionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "health": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "lastTestedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastHealthyAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastErrorCode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "lastTestedAt",
            "lastHealthyAt",
            "lastErrorCode"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "providerKey",
        "name",
        "authType",
        "status",
        "secretVersionId",
        "health",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "ConnectionRotateSecretRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "readOnly": true,
      "type": "object",
      "properties": {
        "expectedSecretVersionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "credential": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "http_headers"
            },
            "headers": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            }
          },
          "required": [
            "schemaVersion",
            "type",
            "headers"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "expectedSecretVersionId",
        "credential"
      ],
      "additionalProperties": false
    }
  }
}
