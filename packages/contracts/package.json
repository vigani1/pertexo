{
  "name": "@pertexo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": false,
      "node": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "contracts:check": "tsx scripts/generate-artifacts.ts --check && redocly lint artifacts/*.openapi.json --config redocly.yaml --format stylish",
    "contracts:generate": "tsx scripts/generate-artifacts.ts --write",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/templates": "workspace:*",
    "@pertexo/workflow-model": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "2.54.3",
    "ajv": "8.20.0"
  }
}
