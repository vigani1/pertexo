{
  "name": "@pertexo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/api-problem.d.ts",
      "default": "./dist/errors/api-problem.js"
    },
    "./connections": {
      "types": "./dist/connections.d.ts",
      "default": "./dist/connections.js"
    },
    "./identity-workspace": {
      "types": "./dist/identity-workspace.d.ts",
      "default": "./dist/identity-workspace.js"
    },
    "./workflow-authoring": {
      "types": "./dist/workflow-authoring.d.ts",
      "default": "./dist/workflow-authoring.js"
    },
    "./workflow-runs": {
      "types": "./dist/workflow-runs.d.ts",
      "default": "./dist/workflow-runs.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "contracts:check": "tsx scripts/generate-artifacts.ts --check",
    "contracts:generate": "tsx scripts/generate-artifacts.ts --write",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/workflow-model": "workspace:*",
    "zod": "4.4.3"
  }
}
