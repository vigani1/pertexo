{
  "name": "@pertexo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/api-problem.d.ts",
      "default": "./dist/errors/api-problem.js"
    },
    "./connections": {
      "types": "./dist/connections.d.ts",
      "default": "./dist/connections.js"
    },
    "./identity-workspace": {
      "types": "./dist/identity-workspace.d.ts",
      "default": "./dist/identity-workspace.js"
    },
    "./node-testing": {
      "types": "./dist/node-testing.d.ts",
      "default": "./dist/node-testing.js"
    },
    "./workflow-authoring": {
      "types": "./dist/workflow-authoring.d.ts",
      "default": "./dist/workflow-authoring.js"
    },
    "./workflow-runs": {
      "types": "./dist/workflow-runs.d.ts",
      "default": "./dist/workflow-runs.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    },
    "./schedules": {
      "types": "./dist/schedules.d.ts",
      "default": "./dist/schedules.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "contracts:check": "tsx scripts/generate-artifacts.ts --check && redocly lint artifacts/*.openapi.json --config redocly.yaml --format stylish",
    "contracts:generate": "tsx scripts/generate-artifacts.ts --write",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage --reporter=default --reporter=json --outputFile.json=../../coverage/contracts/test-results.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/workflow-model": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "2.51.2"
  }
}
