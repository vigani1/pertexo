{
  "name": "@pertexo/workflow-model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./canonical-json": {
      "types": "./dist/canonical-json.d.ts",
      "node": "./dist/canonical-json.js",
      "default": "./dist/canonical-json.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "node": "./dist/graph.js",
      "default": "./dist/graph.js"
    },
    "./graph-contract": {
      "types": "./dist/graph-contract.d.ts",
      "default": "./dist/graph-contract.js"
    },
    "./failure-notification": {
      "types": "./dist/failure-notification.d.ts",
      "default": "./dist/failure-notification.js"
    },
    "./assert-never": {
      "types": "./dist/assert-never.d.ts",
      "default": "./dist/assert-never.js"
    },
    "./mapping": {
      "types": "./dist/mapping.d.ts",
      "node": "./dist/mapping.js",
      "default": "./dist/mapping.js"
    },
    "./json-path": {
      "types": "./dist/json-path.d.ts",
      "default": "./dist/json-path.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    },
    "./observation-window": {
      "types": "./dist/observation-window.d.ts",
      "default": "./dist/observation-window.js"
    },
    "./expressions": {
      "types": "./dist/expressions.d.ts",
      "node": "./dist/expressions.js",
      "default": "./dist/expressions.js"
    }
  },
  "browser": {
    "./dist/index.js": false,
    "./dist/canonical-json.js": false,
    "./dist/graph.js": false,
    "./dist/mapping.js": false,
    "./dist/expressions.js": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "jsonata": "2.2.2",
    "zod": "4.5.4"
  }
}
