{
  "name": "@pertexo/integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": false,
      "node": "./dist/server.js"
    }
  },
  "browser": {
    "./dist/server.js": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/contracts": "workspace:*",
    "@pertexo/node-sdk": "workspace:*",
    "form-data": "4.0.6",
    "zod": "4.6.7",
    "@pertexo/workflow-model": "workspace:*"
  },
  "devDependencies": {}
}
