{
  "name": "@pertexo/integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": false,
      "node": "./dist/server.js"
    }
  },
  "browser": {
    "./dist/server.js": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1152.0",
    "@pertexo/node-sdk": "workspace:*",
    "@smithy/node-http-handler": "4.12.1",
    "form-data": "4.0.6",
    "nodemailer": "10.1.4",
    "zod": "4.6.7",
    "@pertexo/workflow-model": "workspace:*"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "smtp-server": "3.21.1"
  }
}
