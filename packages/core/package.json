{
  "name": "@pertexo/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./variables": {
      "types": "./dist/variables/index.d.ts",
      "default": "./dist/variables/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/contracts": "workspace:*",
    "@pertexo/database": "workspace:*",
    "@pertexo/workflow-model": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@pertexo/workflow-engine": "workspace:*",
    "@types/pg": "8.23.1"
  }
}
