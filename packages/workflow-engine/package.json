{
  "name": "@pertexo/workflow-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": false,
      "node": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "browser": false,
      "node": "./dist/testing.js"
    }
  },
  "browser": {
    "./dist/index.js": false,
    "./dist/server-only.js": false,
    "./dist/testing.js": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage --reporter=default --reporter=json --outputFile.json=../../coverage/workflow-engine/test-results.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/node-sdk": "workspace:*",
    "@pertexo/workflow-model": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.3.0"
  }
}
