{
  "name": "@pertexo/node-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "browser": "./dist/release.js",
      "node": "./dist/release.js",
      "default": "./dist/release.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": false,
      "node": "./dist/server.js"
    }
  },
  "browser": {
    "./dist/server.js": false,
    "./dist/server-only.js": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "zod": "4.5.2"
  }
}
