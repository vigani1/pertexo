{
  "name": "@pertexo/secrets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": false,
      "node": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/database": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "nodemailer": "10.3.1",
    "zod": "4.6.7",
    "@aws-sdk/client-kms": "3.1163.0",
    "@smithy/node-http-handler": "4.14.2",
    "@pertexo/workflow-model": "workspace:*",
    "@pertexo/node-sdk": "workspace:*",
    "@pertexo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/nodemailer": "8.0.2",
    "smtp-server": "3.21.3"
  },
  "browser": {
    "./dist/server.js": false
  }
}
