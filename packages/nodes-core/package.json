{
  "name": "@pertexo/nodes-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": false,
      "node": "./dist/server.js"
    }
  },
  "browser": {
    "./dist/server.js": false,
    "./dist/server-only.js": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/node-sdk": "workspace:*",
    "@pertexo/workflow-model": "workspace:*",
    "cron-parser": "5.10.0",
    "zod": "4.5.4"
  }
}
