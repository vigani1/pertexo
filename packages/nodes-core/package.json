{
  "name": "@pertexo/nodes-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": false,
      "node": "./dist/server.js"
    }
  },
  "browser": {
    "./dist/server.js": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/node-sdk": "workspace:*",
    "@pertexo/workflow-model": "workspace:*",
    "@rgrove/parse-xml": "5.0.0",
    "@streamparser/json": "0.0.26",
    "cron-parser": "5.10.2",
    "css-select": "7.0.0",
    "css-what": "8.0.0",
    "csv-parse": "7.0.3",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "fast-xml-builder": "1.3.1",
    "htmlparser2": "12.0.0",
    "xml-naming": "0.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
