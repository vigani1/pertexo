{
  "name": "@pertexo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./execution": {
      "types": "./dist/execution.d.ts",
      "default": "./dist/execution.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    },
    "./maintenance": {
      "types": "./dist/maintenance.d.ts",
      "default": "./dist/maintenance.js"
    },
    "./operator": {
      "types": "./dist/operator.d.ts",
      "default": "./dist/operator.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "default": "./dist/recovery.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage --reporter=default --reporter=json --outputFile.json=../../coverage/database/test-results.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@pertexo/workflow-model": "workspace:*",
    "cron-parser": "5.10.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "uuid": "13.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
