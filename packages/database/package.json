{
  "name": "@pertexo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "default": "./dist/primitives.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@pertexo/contracts": "workspace:*",
    "@pertexo/node-sdk": "workspace:*",
    "@pertexo/workflow-engine": "workspace:*",
    "@pertexo/workflow-model": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "uuid": "13.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pertexo/nodes-core": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
