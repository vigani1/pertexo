{
  "name": "@pertexo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./attempts": {
      "types": "./dist/attempts/index.d.ts",
      "default": "./dist/attempts/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "default": "./dist/authoring/index.js"
    },
    "./connections": {
      "types": "./dist/connections/index.d.ts",
      "default": "./dist/connections/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "default": "./dist/lifecycle/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "default": "./dist/notifications/index.js"
    },
    "./outbox": {
      "types": "./dist/outbox/index.d.ts",
      "default": "./dist/outbox/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./previews": {
      "types": "./dist/previews/index.d.ts",
      "default": "./dist/previews/index.js"
    },
    "./runs": {
      "types": "./dist/runs/index.d.ts",
      "default": "./dist/runs/index.js"
    },
    "./tenant-access": {
      "types": "./dist/tenant-access/index.d.ts",
      "default": "./dist/tenant-access/index.js"
    },
    "./triggers": {
      "types": "./dist/triggers/index.d.ts",
      "default": "./dist/triggers/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@pertexo/nodes-core": "workspace:*",
    "@pertexo/templates": "workspace:*",
    "@pertexo/workflow-engine": "workspace:*",
    "@pertexo/workflow-model": "workspace:*",
    "cron-parser": "5.10.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "uuid": "13.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
