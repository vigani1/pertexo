{
  "name": "@pertexo/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "node": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./logging": {
      "types": "./dist/logger.d.ts",
      "node": "./dist/logger.js",
      "default": "./dist/logger.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "node": "./dist/telemetry.js",
      "default": "./dist/telemetry.js"
    },
    "./transport-metrics": {
      "types": "./dist/transport-metrics.d.ts",
      "node": "./dist/transport-metrics.js",
      "default": "./dist/transport-metrics.js"
    },
    "./queue-tracing": {
      "types": "./dist/queue-tracing.d.ts",
      "node": "./dist/queue-tracing.js",
      "default": "./dist/queue-tracing.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "node": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./nest-runtime": {
      "types": "./dist/nest-runtime.d.ts",
      "node": "./dist/nest-runtime.js",
      "default": "./dist/nest-runtime.js"
    }
  },
  "browser": {
    "./dist/config.js": false,
    "./dist/index.js": false,
    "./dist/logger.js": false,
    "./dist/telemetry.js": false,
    "./dist/transport-metrics.js": false,
    "./dist/queue-tracing.js": false,
    "./dist/runtime.js": false,
    "./dist/nest-runtime.js": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "pino": "10.3.1",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.10.0"
  }
}
