{
  "name": "@pertexo/artifact-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "browser": {
    "./dist/index.js": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage --reporter=default --reporter=json --outputFile.json=../../coverage/artifact-store/test-results.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@aws-sdk/client-s3": "3.1111.0",
    "@aws-sdk/s3-request-presigner": "3.1111.0",
    "zod": "4.5.4"
  }
}
