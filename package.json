{
  "name": "pertexo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.22.0 <12.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm build && pnpm lint && pnpm contracts:check && pnpm typecheck && pnpm test",
    "contracts:check": "pnpm --filter @pertexo/contracts contracts:check",
    "contracts:generate": "pnpm --filter @pertexo/contracts contracts:generate",
    "dev:api": "pnpm --filter @pertexo/api dev",
    "dev:worker": "pnpm --filter @pertexo/worker dev",
    "deployment:check": "node infrastructure/ecs/validate-deployment.mjs",
    "deployment:render": "node infrastructure/ecs/render-task-definitions.mjs",
    "db:migrate": "pnpm --filter @pertexo/database db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "lifecycle-command:start": "pnpm --filter @pertexo/lifecycle-command start",
    "restore:before-serve": "pnpm --filter @pertexo/recovery start",
    "retention:start": "pnpm --filter @pertexo/retention start",
    "test": "pnpm --recursive --if-present test",
    "test:integration": "pnpm --filter @pertexo/artifact-store test:integration && pnpm --filter @pertexo/database test:integration && pnpm --filter @pertexo/worker test:integration && pnpm --filter @pertexo/api test:integration",
    "typecheck": "tsc --build --pretty false && pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
