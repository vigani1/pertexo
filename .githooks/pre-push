#!/bin/sh
set -eu

if [ "${PERTEXO_SKIP_PRE_PUSH_CHECKS:-}" = "1" ]; then
  echo "Skipping Pertexo pre-push checks because PERTEXO_SKIP_PRE_PUSH_CHECKS=1."
  exit 0
fi

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

if [ "${PERTEXO_PRE_PUSH_FULL:-}" = "1" ]; then
  echo "Running the full Pertexo pre-push checks (static, unit, coverage, and browser probe gates)..."
  exec pnpm prepush:check
fi

echo "Running the fast Pertexo pre-push checks (static gates plus lint, typecheck, and unit tests for changed packages)..."
echo "CI runs every suite on the pull request; set PERTEXO_PRE_PUSH_FULL=1 to run them all locally."
exec pnpm prepush:fast
