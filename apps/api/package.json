{
  "name": "@pertexo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node ../../infrastructure/development/run-nest-dev.mjs",
    "start": "node dist/main.js",
    "test": "node --test ../../infrastructure/testing/editor-browser-envelope-keys.test.mjs && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:sse-resilience": "vitest run --config vitest.sse-resilience.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-fastify": "11.2.6",
    "@opentelemetry/api": "1.9.1",
    "@pertexo/artifact-store": "workspace:*",
    "@pertexo/contracts": "workspace:*",
    "@pertexo/database": "workspace:*",
    "@pertexo/execution": "workspace:*",
    "@pertexo/integrations": "workspace:*",
    "@pertexo/node-catalog": "workspace:*",
    "@pertexo/node-sdk": "workspace:*",
    "@pertexo/nodes-core": "workspace:*",
    "@pertexo/observability": "workspace:*",
    "@pertexo/queue": "workspace:*",
    "@pertexo/rate-limit": "workspace:*",
    "@pertexo/workflow-engine": "workspace:*",
    "@pertexo/workflow-model": "workspace:*",
    "better-auth": "1.7.5",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "kysely": "0.29.6",
