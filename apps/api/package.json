{
  "name": "@pertexo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:compatibility-rollout": "vitest run --config vitest.compatibility-rollout.config.ts",
    "test:sse-resilience": "vitest run --config vitest.sse-resilience.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/contracts": "workspace:*",
    "@pertexo/database": "workspace:*",
    "@pertexo/integrations": "workspace:*",
    "@pertexo/node-catalog": "workspace:*",
    "@pertexo/node-sdk": "workspace:*",
    "@pertexo/nodes-core": "workspace:*",
    "@pertexo/observability": "workspace:*",
    "@pertexo/queue": "workspace:*",
    "@pertexo/rate-limit": "workspace:*",
    "@pertexo/workflow-engine": "workspace:*",
    "@pertexo/workflow-model": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@opentelemetry/api": "1.9.0",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "jose": "6.2.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/sdk-node": "0.221.0",
    "@types/pg": "8.21.0",
    "pg": "8.23.0"
  }
}
