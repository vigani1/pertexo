{
  "name": "@pertexo/retention",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage:entrypoints": "vitest run --config vitest.entrypoints-coverage.config.ts --coverage --reporter=default --reporter=json --outputFile.json=../../coverage/retention-entrypoints/test-results.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@pertexo/artifact-store": "workspace:*",
    "@pertexo/database": "workspace:*",
    "@pertexo/observability": "workspace:*",
    "zod": "4.6.2"
  }
}
