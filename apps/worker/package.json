{
  "name": "@pertexo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node ../../infrastructure/development/run-nest-dev.mjs",
    "start": "node dist/main.js",
    "test": "node --test ../../infrastructure/testing/oauth2-stand-in.test.mjs && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:trigger": "vitest run --config vitest.integration.config.ts test/triggers/schedule.integration.test.ts",
    "test:resilience": "vitest run --config vitest.resilience.config.ts",
    "test:fault": "WORKER_FAULT_TESTS=true vitest run --config vitest.resilience.config.ts test/recovery/",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@opentelemetry/api": "1.9.1",
    "@pertexo/artifact-store": "workspace:*",
    "@pertexo/core": "workspace:*",
    "@pertexo/database": "workspace:*",
    "@pertexo/integrations": "workspace:*",
    "@pertexo/node-catalog": "workspace:*",
    "@pertexo/node-sdk": "workspace:*",
    "@pertexo/nodes-core": "workspace:*",
    "@pertexo/observability": "workspace:*",
    "@pertexo/queue": "workspace:*",
    "@pertexo/rate-limit": "workspace:*",
    "@pertexo/workflow-engine": "workspace:*",
    "@pertexo/workflow-model": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fastify/busboy": "3.2.3",
    "@nestjs/testing": "11.2.7",
    "@types/pg": "8.23.1",
    "bullmq": "6.3.16",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "smtp-server": "3.21.1"
  }
}
