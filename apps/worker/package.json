{
  "name": "@pertexo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:phase0e": "vitest run --config vitest.phase0e.config.ts",
    "test:resilience": "vitest run --config vitest.resilience.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/database": "workspace:*",
    "@pertexo/nodes-core": "workspace:*",
    "@pertexo/observability": "workspace:*",
    "@pertexo/queue": "workspace:*",
    "@pertexo/workflow-engine": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@pertexo/artifact-store": "workspace:*",
    "@pertexo/workflow-model": "workspace:*",
    "@types/pg": "8.21.0",
    "bullmq": "6.1.2",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  }
}
