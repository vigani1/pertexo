{
  "name": "@pertexo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage --reporter=default --reporter=json --outputFile.json=../../coverage/worker/test-results.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:trigger": "vitest run --config vitest.integration.config.ts test/schedule-trigger.integration.test.ts",
    "test:resilience": "vitest run --config vitest.resilience.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@opentelemetry/api": "1.9.0",
    "@pertexo/artifact-store": "workspace:*",
    "@pertexo/database": "workspace:*",
    "@pertexo/integrations": "workspace:*",
    "@pertexo/node-catalog": "workspace:*",
    "@pertexo/node-sdk": "workspace:*",
    "@pertexo/nodes-core": "workspace:*",
    "@pertexo/observability": "workspace:*",
    "@pertexo/queue": "workspace:*",
    "@pertexo/rate-limit": "workspace:*",
    "@pertexo/workflow-engine": "workspace:*",
    "@pertexo/workflow-model": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.21.0",
    "bullmq": "6.3.4",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "pg": "8.23.0"
  }
}
