{
  "name": "@pertexo/lifecycle-command",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage --reporter=default --reporter=json --outputFile.json=../../coverage/lifecycle-command/test-results.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@pertexo/artifact-store": "workspace:*",
    "@pertexo/database": "workspace:*",
    "@pertexo/observability": "workspace:*",
    "zod": "4.4.3"
  }
}
