# TLS terminates at the trusted front proxy; direct HTTP uses nginx's scheme.
map $http_x_forwarded_proto $pertexo_forwarded_proto {
  default $scheme;
  http http;
  https https;
}

# The same policy in each block below, because nginx drops inherited add_header
# lines in any block that sets its own; apps/web/test/deployment-proxy.test.ts
# keeps them equal. Scripts come only from the app's own files. Styles stay
# 'unsafe-inline': the boot screen's first frame and the dialog and toast libraries
# need inline styles, and a style can't run anything. Small fonts are data: URLs.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # The app's text files go out compressed; fonts and images already are.
  # Requests arrive through Caddy or a load balancer, and nginx won't compress
  # for a request that carries a Via header unless told to.
  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_vary on;
  gzip_types text/css application/javascript application/json image/x-icon text/plain;

  # An OAuth2 callback's query holds a code and state, so it never reaches a log.
  # Caddy sends it straight to the API; this covers an install with nginx in front.
  # The error log counts too: a failed upstream writes the request line there.
  location = /v1/connections/oauth2/callback {
    access_log off;
    error_log /dev/null crit;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;
    set $pertexo_api_upstream ${PERTEXO_API_UPSTREAM};
    proxy_pass $pertexo_api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $pertexo_forwarded_proto;
  }

  location /v1 {
    # API responses, event streams and CSV exports among them, pass through
    # exactly as the API sent them.
    gzip off;
    # A restarted API can come back at another address. A variable makes nginx
    # resolve the name while running, and lets it start before the API exists.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;
    set $pertexo_api_upstream ${PERTEXO_API_UPSTREAM};
    proxy_pass $pertexo_api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $pertexo_forwarded_proto;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
  }

  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # No other site may frame Pertexo's pages (clickjacking on actions like
    # deleting a workspace). X-Frame-Options covers older browsers.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
  }

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
  add_header X-Frame-Options "DENY" always;
}
