# Local development only. These defaults are intentionally not suitable for
# staging or production. Copy this file to .env before starting Compose.

POSTGRES_IMAGE=postgres:18
POSTGRES_PORT=5432
POSTGRES_DB=pertexo

# Bootstrap superuser used only by the official image during first startup.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=pertexo-local-superuser

# The owner role is NOLOGIN. Migrations connect as POSTGRES_MIGRATION_USER and
# explicitly SET ROLE to this owner when a migration needs ownership privileges.
POSTGRES_OWNER_USER=pertexo_owner

POSTGRES_MIGRATION_USER=pertexo_migration
POSTGRES_MIGRATION_PASSWORD=pertexo-local-migration

# Maintenance receives monitoring privileges but does not own application data.
POSTGRES_MAINTENANCE_USER=pertexo_maintenance
POSTGRES_MAINTENANCE_PASSWORD=pertexo-local-maintenance

# Lifecycle command dispatch is separate from broad recovery maintenance.
POSTGRES_LIFECYCLE_COMMAND_USER=pertexo_lifecycle_command
POSTGRES_LIFECYCLE_COMMAND_PASSWORD=pertexo-local-lifecycle-command

# API and worker use distinct restricted serving roles. Neither receives
# BYPASSRLS or table privileges here; migrations grant only required tables.
POSTGRES_API_RUNTIME_USER=pertexo_api
POSTGRES_API_RUNTIME_PASSWORD=pertexo-local-api

POSTGRES_WORKER_RUNTIME_USER=pertexo_worker
POSTGRES_WORKER_RUNTIME_PASSWORD=pertexo-local-worker

# The dispatcher can claim only outbox rows through an explicit all-workspace
# RLS policy. It cannot assume owner/migration/maintenance or serving roles.
POSTGRES_DISPATCHER_RUNTIME_USER=pertexo_dispatcher
POSTGRES_DISPATCHER_RUNTIME_PASSWORD=pertexo-local-dispatcher

# Application connection strings. The migration command connects with the
# migration role and explicitly assumes the NOLOGIN owner for reviewed DDL.
DATABASE_MIGRATION_URL=postgresql://pertexo_migration:pertexo-local-migration@localhost:5432/pertexo
DATABASE_MAINTENANCE_URL=postgresql://pertexo_maintenance:pertexo-local-maintenance@localhost:5432/pertexo
DATABASE_LIFECYCLE_COMMAND_URL=postgresql://pertexo_lifecycle_command:pertexo-local-lifecycle-command@localhost:5432/pertexo
DATABASE_API_URL=postgresql://pertexo_api:pertexo-local-api@localhost:5432/pertexo
DATABASE_WORKER_URL=postgresql://pertexo_worker:pertexo-local-worker@localhost:5432/pertexo
DATABASE_DISPATCHER_URL=postgresql://pertexo_dispatcher:pertexo-local-dispatcher@localhost:5432/pertexo

# Identity is optional in local development and tests, but all required OIDC
# fields must be set in staging and production. Replace every example value;
# generate the transaction key with a cryptographically secure 32-byte source.
# OIDC_ISSUER=https://identity.example.com
# OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/oauth2/authorize
# OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth2/token
# OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# OIDC_CLIENT_ID=replace-me
# OIDC_CLIENT_SECRET=replace-me
# OIDC_REDIRECT_URI=https://api.example.com/v1/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_ALLOWED_ALGORITHMS=RS256
# OIDC_TRANSACTION_KEY_VERSION=v1
# OIDC_TRANSACTION_KEY=replace-with-base64-encoded-32-byte-key
# OIDC_TRANSACTION_PREVIOUS_KEYS=[{"version":"v0","key":"replace-me"}]
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAME_SITE=lax

# Connection credentials use one managed-KMS data key per immutable secret
# version. These values are optional only while the connection API is disabled
# in local development; staging and production require both. A custom endpoint
# is intended for an approved KMS-compatible test service and must use HTTPS in
# deployed environments.
# CONNECTION_KMS_KEY_REFERENCE=alias/pertexo-connections
# CONNECTION_KMS_REGION=eu-central-1
# CONNECTION_KMS_ENDPOINT=https://kms.example.com

# Redis is rebuildable BullMQ transport. AOF improves local restart behavior;
# PostgreSQL remains authoritative and Redis is configured never to evict keys.
REDIS_IMAGE=redis:8.2.8-alpine
REDIS_PORT=6379
REDIS_PASSWORD=pertexo-local-redis
REDIS_URL=redis://:pertexo-local-redis@localhost:6379/0

# S3Mock is a local S3-compatible test service, not a production storage
# recommendation. Production IAM, encryption, and lifecycle remain separate.
S3MOCK_IMAGE=adobe/s3mock:5.1.0
ARTIFACT_STORE_PORT=9090
ARTIFACT_STORE_ENDPOINT=http://localhost:9090
ARTIFACT_STORE_REGION=us-east-1
ARTIFACT_STORE_BUCKET=pertexo-artifacts
ARTIFACT_STORE_ACCESS_KEY_ID=pertexo-local
ARTIFACT_STORE_SECRET_ACCESS_KEY=pertexo-local-secret
ARTIFACT_STORE_FORCE_PATH_STYLE=true
ARTIFACT_MAX_BYTES=10485760

# Two independent MinIO processes exercise S3-compatible Object Lock, policy,
# and failure-recovery controls locally. They do not prove AWS regional
# infrastructure, IAM, durability, or an actual Frankfurt/Ireland failover.
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
CONTROL_LEDGER_INTEGRATION_PROVIDER=minio
CONTROL_LEDGER_PORT=9091
CONTROL_LEDGER_ENDPOINT=http://localhost:9091
CONTROL_LEDGER_REGION=eu-central-1
CONTROL_LEDGER_BUCKET=pertexo-control-ledger
CONTROL_LEDGER_ACCESS_KEY_ID=pertexo-local-ledger-primary
CONTROL_LEDGER_SECRET_ACCESS_KEY=pertexo-local-ledger-primary-secret
CONTROL_LEDGER_ADMIN_ACCESS_KEY_ID=pertexo-local-primary-admin
CONTROL_LEDGER_ADMIN_SECRET_ACCESS_KEY=pertexo-local-primary-admin-secret
CONTROL_LEDGER_FORCE_PATH_STYLE=true
CONTROL_LEDGER_REQUEST_TIMEOUT_MS=5000
CONTROL_LEDGER_MIN_RETENTION_DAYS=30
CONTROL_LEDGER_RECOVERY_PORT=9092
CONTROL_LEDGER_RECOVERY_ENDPOINT=http://localhost:9092
CONTROL_LEDGER_RECOVERY_REGION=eu-west-1
CONTROL_LEDGER_RECOVERY_BUCKET=pertexo-control-ledger-recovery
CONTROL_LEDGER_RECOVERY_ACCESS_KEY_ID=pertexo-local-ledger-recovery
CONTROL_LEDGER_RECOVERY_SECRET_ACCESS_KEY=pertexo-local-ledger-recovery-secret
CONTROL_LEDGER_RECOVERY_ADMIN_ACCESS_KEY_ID=pertexo-local-recovery-admin
CONTROL_LEDGER_RECOVERY_ADMIN_SECRET_ACCESS_KEY=pertexo-local-recovery-admin-secret
CONTROL_LEDGER_RECOVERY_FORCE_PATH_STYLE=true
CONTROL_LEDGER_RECOVERY_REQUEST_TIMEOUT_MS=5000
CONTROL_LEDGER_RECOVERY_MIN_RETENTION_DAYS=30

# One-shot restore-before-serve reconciliation bounds. The deployment must stop
# ingress and every durable writer before running this process.
RESTORE_TIMEOUT_MS=21600000
RESTORE_INVENTORY_PAGE_SIZE=100
RESTORE_MAX_INVENTORY_PAGES=10000
RESTORE_MAX_INVENTORY_SWEEPS=3
RESTORE_MAX_WORKSPACE_RECONCILE_ATTEMPTS=10
RESTORE_LEDGER_PAGE_SIZE=100
RESTORE_LEDGER_MAX_PAGES=10
RESTORE_LEDGER_MAX_RECORDS=1000
RESTORE_EXTERNAL_OPERATION_TIMEOUT_MS=120000
RESTORE_DATABASE_LOCK_TIMEOUT_MS=10000
RESTORE_DATABASE_STATEMENT_TIMEOUT_MS=30000

# API and worker observability. Leave the exporter unset for a local no-network
# mode, or point it at an OTLP/HTTP collector base URL.
SERVICE_VERSION=0.0.0-dev
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
