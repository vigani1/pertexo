# Local development only. These defaults are intentionally not suitable for
# staging or production. Copy this file to .env before starting Compose.

# Tag is for readability; Compose pulls the immutable manifest digest.
POSTGRES_IMAGE=postgres:18@sha256:4ef4dbc939d61acea57712655ddb4b4ab27419c913f94cca0cd57cb3ea3c2280
POSTGRES_PORT=5432
POSTGRES_DB=pertexo

# Bootstrap superuser used only by the official image during first startup.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=pertexo-local-superuser

# The owner role is NOLOGIN. Migrations connect as POSTGRES_MIGRATION_USER and
# explicitly SET ROLE to this owner when a migration needs ownership privileges.
POSTGRES_OWNER_USER=pertexo_owner

POSTGRES_MIGRATION_USER=pertexo_migration
POSTGRES_MIGRATION_PASSWORD=pertexo-local-migration

# The API and worker serve tenant requests as the app role. RLS scopes every
# query to one workspace; the role never receives BYPASSRLS.
POSTGRES_APP_USER=pertexo_app
POSTGRES_APP_PASSWORD=pertexo-local-app

# Cross-workspace work (outbox dispatch, retention, workspace lifecycle
# commands and ops commands) runs as the maintenance role.
POSTGRES_MAINTENANCE_USER=pertexo_maintenance
POSTGRES_MAINTENANCE_PASSWORD=pertexo-local-maintenance

# Application connection strings. The migration command connects with the
# migration role and explicitly assumes the NOLOGIN owner for reviewed DDL.
DATABASE_MIGRATION_URL=postgresql://pertexo_migration:pertexo-local-migration@localhost:5432/pertexo
DATABASE_URL=postgresql://pertexo_app:pertexo-local-app@localhost:5432/pertexo
DATABASE_MAINTENANCE_URL=postgresql://pertexo_maintenance:pertexo-local-maintenance@localhost:5432/pertexo

# Better Auth owns password/social authentication and the sole browser session.
# The local secret below is deliberately development-only. Production requires
# an independently generated secret and a configured durable auth-mail adapter;
# AUTH_MAIL_MODE=disabled fails closed when no adapter is available.
# AUTH_MAIL_MODE=local sends no mail: in development the API prints each
# verification, password-reset, and email-change link to its console.
BETTER_AUTH_SECRET=pertexo-local-better-auth-secret-change-before-deployment
AUTH_MAIL_MODE=local
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173
# Local HTTP derives non-secure cookies from PUBLIC_WEB_ORIGIN. Deployed HTTPS
# environments validate and require secure cookies.
# SESSION_COOKIE_SECURE=false
# Deployed environments use AUTH_MAIL_MODE=durable in the API and configure:
# AUTH_MAIL_FROM=security@example.com
# AUTH_MAIL_KEY=base64-encoded-32-byte-key
# AUTH_MAIL_KEY_VERSION=v1
# AUTH_MAIL_PREVIOUS_KEYS=[]
# Worker-only durable authentication-mail delivery:
# AUTH_MAIL_EMAIL_API_KEY=replace-with-system-resend-key
# AUTH_MAIL_EMAIL_TIMEOUT_MILLIS=5000
# AUTH_MAIL_POLL_MILLIS=1000
# Social buttons appear only when both values for that provider are present.
# Provider callback URLs use the public same-origin auth prefix, for example:
# http://127.0.0.1:5173/v1/auth/callback/google
# AUTH_GOOGLE_CLIENT_ID=replace-me
# AUTH_GOOGLE_CLIENT_SECRET=replace-me
# AUTH_GITHUB_CLIENT_ID=replace-me
# AUTH_GITHUB_CLIENT_SECRET=replace-me
# AUTH_MICROSOFT_CLIENT_ID=replace-me
# AUTH_MICROSOFT_CLIENT_SECRET=replace-me
# AUTH_MICROSOFT_TENANT_ID=common
# AUTH_APPLE_CLIENT_ID=replace-me
# AUTH_APPLE_CLIENT_SECRET=replace-me
# Invitation links use a dedicated application envelope shared only by the API
# and invitation-delivery worker. The system Resend credential is platform
# owned and must never be sourced from a workspace connection.
# INVITATION_TOKEN_KEY_VERSION=v1
# INVITATION_TOKEN_KEY=replace-with-base64-encoded-32-byte-key
# INVITATION_TOKEN_PREVIOUS_KEYS=[{"version":"v0","key":"replace-me"}]
# INVITATION_EMAIL_API_KEY=replace-with-system-resend-key
# INVITATION_EMAIL_FROM=invites@example.com
# INVITATION_EMAIL_TIMEOUT_MILLIS=5000
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAME_SITE=lax

# Vite's server-side development proxy defaults to http://127.0.0.1:3000.
# PERTEXO_API_PROXY_TARGET=http://127.0.0.1:3000
# The production web proxy template requires an internal API origin with no
# trailing path so the public /v1 path is preserved.
# PERTEXO_API_UPSTREAM=http://pertexo-api.internal:3000

# Connection credentials use one managed-KMS data key per immutable secret
# version. These values are optional only while the connection API is disabled
# in local development; staging and production require both. A custom endpoint
# is intended for an approved KMS-compatible test service and must use HTTPS in
# deployed environments.
# CONNECTION_KMS_KEY_REFERENCE=alias/pertexo-connections
# CONNECTION_KMS_REGION=eu-central-1
# CONNECTION_KMS_ENDPOINT=https://kms.example.com

# Redis is rebuildable BullMQ transport. AOF improves local restart behavior;
# PostgreSQL remains authoritative and Redis is configured never to evict keys.
REDIS_IMAGE=redis:8.2.8-alpine@sha256:a7859ed111db3c1f5404a973a4747505d559fb5ca32d37e447afc0ef845a2103
REDIS_PORT=6379
REDIS_PASSWORD=pertexo-local-redis
REDIS_URL=redis://:pertexo-local-redis@localhost:6379/0

# S3Mock is a local S3-compatible test service, not a production storage
# recommendation. Production IAM, encryption, and lifecycle remain separate.
S3MOCK_IMAGE=adobe/s3mock:5.1.0@sha256:65cf60155a2e235fe7d5bf6c633747d6fc7ed93f9f5a6727d86470026b83c2a2
ARTIFACT_STORE_PORT=9090
ARTIFACT_STORE_ENDPOINT=http://localhost:9090
ARTIFACT_STORE_REGION=us-east-1
ARTIFACT_STORE_BUCKET=pertexo-artifacts
ARTIFACT_STORE_ACCESS_KEY_ID=pertexo-local
ARTIFACT_STORE_SECRET_ACCESS_KEY=pertexo-local-secret
ARTIFACT_STORE_FORCE_PATH_STYLE=true
ARTIFACT_MAX_BYTES=10485760

# The worker consumes every outbox job. Failure notifications also need the
# CONNECTION_KMS_* values and invitation emails the INVITATION_* values; without
# them those jobs wait in the outbox.

# API and worker observability. Leave the exporter unset for a local no-network
# mode, or point it at an OTLP/HTTP collector base URL.
SERVICE_VERSION=0.0.0-dev
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
